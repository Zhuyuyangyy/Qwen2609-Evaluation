+def _normalise_tool(tool_name: Any) -> str:
+    """Return the canonical form of ``tool_name``: lowercased, empty when absent.
+
+    This is the single implementation of tool-name canonicalisation for the
+    whole shield. ``trust_policy.classify_tool`` resolves it through this
+    module at call time, so the two paths cannot drift apart: a classifier
+    that strips and a signal extractor that does not would disagree about the
+    same call, and the disagreement would surface as a risk score nobody can
+    explain.
+
+    The call sites annotate the parameter ``str`` but callers are not always
+    well typed -- a missing name arrives as ``None``, replayed benchmark rows
+    carry numbers. ``or ""`` keeps those empty rather than raising, and avoids
+    turning an absent name into the literal ``"none"``, which would match no
+    vocabulary and silently classify as unknown.
+    """
     return str(tool_name or "").lower()
 
 
